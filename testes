import pandas as pd
import os
from openpyxl import load_workbook


class ProcessadorExcel:
    def __init__(self, arquivo_entrada, arquivo_saida, mapeamento_colunas, filtros, colunas_multiplicar=None, fator_multiplicacao=1.3, aba_origem="Panilha1", aba_destino="Panilha1"):
        self.arquivo_entrada = arquivo_entrada
        self.arquivo_saida = arquivo_saida
        self.mapeamento_colunas = {k.lower(): v for k, v in mapeamento_colunas.items()}
        self.filtros = {k.lower(): v for k, v in filtros.items()}
        self.colunas_multiplicar = [col.lower() for col in colunas_multiplicar] if colunas_multiplicar else []
        self.fator_multiplicacao = fator_multiplicacao
        self.aba_origem = aba_origem
        self.aba_destino = aba_destino

    def ler_excel(self):
        try:
            df = pd.read_excel(self.arquivo_entrada, sheet_name=self.aba_origem)
            df.columns = [col.lower().strip() if pd.notna(col) else None for col in df.columns]
            df = df.dropna(axis=1, how='all')
            
            for coluna, valor in self.filtros.items():
                if coluna in df.columns:
                    df = df[df[coluna] == valor]
            
            for coluna in self.colunas_multiplicar:
                if coluna in df.columns:
                    df[coluna] *= self.fator_multiplicacao
            
            df = df.rename(columns=self.mapeamento_colunas)
            return df
        except Exception as e:
            print(f"Erro ao ler o arquivo Excel: {e}")
            return None

    def salvar_excel(self, df):
        try:
            if os.path.exists(self.arquivo_saida):
                df_saida = pd.read_excel(self.arquivo_saida, sheet_name=self.aba_destino)
                df_saida.columns = [col.lower().strip() if pd.notna(col) else None for col in df_saida.columns]
                
                # Atualiza apenas as colunas presentes no mapeamento sem criar duplicatas
                for coluna_origem, coluna_destino in self.mapeamento_colunas.items():
                    if coluna_destino in df_saida.columns and coluna_origem in df.columns:
                        df_saida[coluna_destino] = df[coluna_destino].values
                
                df = df_saida
            
            with pd.ExcelWriter(self.arquivo_saida, mode='w', engine='openpyxl') as writer:
                df.to_excel(writer, sheet_name=self.aba_destino, index=False)
            print(f"Arquivo atualizado: {self.arquivo_saida}")
        except Exception as e:
            print(f"Erro ao salvar o arquivo: {e}")

    def processar(self):
        df = self.ler_excel()
        if df is not None:
            self.salvar_excel(df)


