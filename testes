import pandas as pd
import numpy as np
from openpyxl import load_workbook
from openpyxl.utils.dataframe import dataframe_to_rows

class ProcessadorExcel:
    def __init__(self, arquivos_entrada, arquivo_saida, mapeamento_colunas, filtros=None, 
                 colunas_multiplicar=None, fator_multiplicacao=None, 
                 aba_origem="Planilha1", aba_destino="Planilha1"):
        """
        :arquivos_entrada: Lista de caminhos dos arquivos Excel de entrada.
        :arquivo_saida: Caminho do arquivo Excel de saída.
        :mapeamento_colunas: Dicionário mapeando colunas de origem para destino.
        :filtros: Dicionário de filtros (ex: {"X": "revenda"}).
        :colunas_multiplicar: Lista de colunas a serem multiplicadas.
        :fator_multiplicacao: Valor pelo qual as colunas serão multiplicadas.
        :aba_origem: Nome da aba de onde os dados serão lidos.
        :aba_destino: Nome da aba onde os dados serão salvos.
        """
        self.arquivos_entrada = arquivos_entrada
        self.arquivo_saida = arquivo_saida
        self.mapeamento_colunas = {k.lower(): v for k, v in mapeamento_colunas.items()}
        self.filtros = {k.lower(): v for k, v in (filtros or {}).items()}
        self.colunas_multiplicar = [col.lower() for col in (colunas_multiplicar or [])]
        self.fator_multiplicacao = fator_multiplicacao
        self.aba_origem = aba_origem
        self.aba_destino = aba_destino
        self.segmentos_especiais = ['seguros', 'netflix', 'premiere', 'vale saúde vivae', 'vivo guru', 'vivo play inicial']

    def ler_excel(self, arquivo):
        """Lê o arquivo Excel e aplica os filtros."""
        try:
            df = pd.read_excel(arquivo, sheet_name=self.aba_origem)
            
            # Normaliza os nomes das colunas
            df.columns = [str(col).lower().strip() for col in df.columns]
            
            # Remove colunas totalmente vazias
            df = df.dropna(axis=1, how='all')
            
            # Verifica se as colunas existem
            for coluna in self.mapeamento_colunas.keys():
                if coluna not in df.columns:
                    print(f"Aviso: Coluna '{coluna}' não encontrada no arquivo {arquivo}")
                    continue
            
            return df
        except Exception as e:
            print(f"Erro ao ler o arquivo Excel {arquivo}: {e}")
            return None

    def aplicar_filtros(self, df):
        """Aplica os filtros ao DataFrame."""
        if not self.filtros:
            return df
            
        for coluna, valor in self.filtros.items():
            if coluna in df.columns:
                df = df[df[coluna] == valor]
            else:
                print(f"Aviso: Coluna de filtro '{coluna}' não encontrada")
        return df

    def aplicar_multiplicacao(self, df):
        """Aplica a multiplicação nas colunas especificadas para segmentos especiais."""
        if not self.colunas_multiplicar or self.fator_multiplicacao is None:
            return df
            
        if 'segmento produto' in df.columns:
            condicao = df['segmento produto'].str.lower().isin([s.lower() for s in self.segmentos_especiais])
            
            for coluna in self.colunas_multiplicar:
                if coluna in df.columns:
                    df.loc[condicao, coluna] = df.loc[condicao, coluna] * self.fator_multiplicacao
                else:
                    print(f"Aviso: Coluna para multiplicação '{coluna}' não encontrada")
        else:
            print("Aviso: Coluna 'segmento produto' não encontrada para aplicar multiplicação")
            
        return df

    def processar_dados(self, df):
        """Processa os dados conforme as regras especificadas."""
        if df is None:
            return None
            
        df = self.aplicar_filtros(df)
        df = self.aplicar_multiplicacao(df)
        
        # Seleciona apenas as colunas mapeadas que existem no DataFrame
        colunas_disponiveis = [col for col in self.mapeamento_colunas.keys() if col in df.columns]
        df = df[colunas_disponiveis].rename(columns=self.mapeamento_colunas)
        
        return df

    def salvar_excel(self, df_final):
        """Salva os dados no arquivo de saída mantendo a estrutura original."""
        try:
            # Carrega o arquivo de saída existente ou cria um novo
            try:
                book = load_workbook(self.arquivo_saida)
                if self.aba_destino in book.sheetnames:
                    ws = book[self.aba_destino]
                else:
                    ws = book.create_sheet(self.aba_destino)
            except FileNotFoundError:
                book = Workbook()
                ws = book.active
                ws.title = self.aba_destino
            
            # Obtém os cabeçalhos originais
            cabecalhos = [ws.cell(row=1, column=col).value for col in range(1, ws.max_column + 1)]
            
            # Se o arquivo estiver vazio, escreve os cabeçalhos
            if not cabecalhos or all(h is None for h in cabecalhos):
                for col_num, col_name in enumerate(df_final.columns, start=1):
                    ws.cell(row=1, column=col_num, value=col_name)
                cabecalhos = list(df_final.columns)
            
            # Mapeia as colunas do DataFrame para as colunas no arquivo de saída
            mapeamento_saida = {col: i+1 for i, col in enumerate(cabecalhos) if col in df_final.columns}
            
            # Encontra a próxima linha vazia
            linha_inicio = ws.max_row + 1 if ws.max_row > 1 else 2
            
            # Escreve os dados nas colunas correspondentes
            for idx, row in df_final.iterrows():
                for col_df, valor in row.items():
                    if col_df in mapeamento_saida:
                        ws.cell(row=linha_inicio + idx, column=mapeamento_saida[col_df], value=valor)
            
            book.save(self.arquivo_saida)
            print(f"Dados salvos com sucesso em {self.arquivo_saida} na aba '{self.aba_destino}'")
            
        except Exception as e:
            print(f"Erro ao salvar o arquivo Excel: {e}")

    def processar(self):
        """Executa o processamento de todos os arquivos de entrada."""
        dfs = []
        
        for arquivo in self.arquivos_entrada:
            print(f"Processando arquivo: {arquivo}")
            df = self.ler_excel(arquivo)
            df_processado = self.processar_dados(df)
            if df_processado is not None and not df_processado.empty:
                dfs.append(df_processado)
        
        if dfs:
            df_final = pd.concat(dfs, ignore_index=True)
            self.salvar_excel(df_final)
        else:
            print("Nenhum dado válido para salvar.")


